@charset "utf-8";

:root { --blue: #0052ff; --ink: #0a2540; --mint: #00d4b2; --paper: #f8fafc; --muted: #66768b; --line: #e3eaf2; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; background: var(--paper); color: var(--ink); font-family: Manrope, sans-serif; }

button, a { font: inherit; }

button { cursor: pointer; }

a { color: inherit; text-decoration: none; }

.container { max-width: 1180px; margin: auto; padding-left: 28px; padding-right: 28px; }

.site-shell { overflow: hidden; }

.topline { background: var(--ink); color: rgb(184, 201, 219); font-size: 11px; letter-spacing: 0.04em; }

.topline-inner { height: 34px; display: flex; align-items: center; gap: 26px; }

.topline span { display: flex; align-items: center; gap: 7px; }

.topline svg { color: var(--mint); }

.topline-right { margin-left: auto; }

.topline b { color: rgb(84, 112, 140); margin: 0px 3px; }

